{
    "name": "Ticket Shop Testing Workshop",
    "image": "mcr.microsoft.com/devcontainers/java:3-25-trixie",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "none",
            "installMaven": true
        }
    },
    "forwardPorts": [8080],
    "postCreateCommand": "mvn -B -q verify",
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "humao.rest-client"
            ],
            "settings": {
                "java.configuration.updateBuildConfiguration": "automatic"
            }
        }
    }
}
